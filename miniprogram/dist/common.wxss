.consent-bar{align-items:center;display:flex;margin-bottom:16rpx;padding:8rpx 4rpx}.consent-bar__box{background:#fff;border:2rpx solid #c4c9d4;border-radius:8rpx;box-sizing:border-box;flex-shrink:0;height:32rpx;margin-right:12rpx;width:32rpx}.consent-bar__text{color:#64748b;font-size:24rpx;line-height:1.5}.consent-bar__link{color:#6366f1;font-weight:500}.proc-ph{align-items:center;background:linear-gradient(135deg,#f2f5ff,#f7f9ff);border:2rpx dashed #c7d2fe;border-radius:28rpx;box-sizing:border-box;display:flex;flex-direction:column;height:360rpx;justify-content:center;padding:24rpx}.proc-ph__spinner{animation:proc-ph-spin .8s linear infinite;border:6rpx solid rgba(99,102,241,.15);border-radius:50%;border-top-color:#6366f1;height:56rpx;width:56rpx}.proc-ph__title{color:#4338ca;font-size:26rpx;font-weight:600;margin-top:24rpx}.proc-ph__desc{color:#64748b;font-size:22rpx;margin-top:10rpx;text-align:center}@keyframes proc-ph-spin{to{transform:rotate(1turn)}}
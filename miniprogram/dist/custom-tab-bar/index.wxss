.ctab{background:hsla(0,0%,100%,.97);border-top:1rpx solid #eef1f6;bottom:0;display:flex;left:0;padding-bottom:env(safe-area-inset-bottom);position:fixed;right:0;z-index:100}.ctab__item{align-items:center;display:flex;flex:1;flex-direction:column;gap:6rpx;height:104rpx;justify-content:center}.ctab__icon{height:46rpx;width:46rpx}.ctab__text{color:#94a3b8;font-size:20rpx;line-height:1}.ctab__text--on{color:#6366f1;font-weight:600}
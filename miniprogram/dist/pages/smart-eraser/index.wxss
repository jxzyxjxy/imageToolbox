.page{min-height:100vh;padding:32rpx 32rpx 0}.banner{border-radius:40rpx;padding:40rpx 36rpx}.banner--amber{background:linear-gradient(135deg,#f59e0b,#f97316);box-shadow:0 12rpx 32rpx rgba(245,158,11,.35)}.banner--pink{background:linear-gradient(135deg,#ec4899,#f43f5e);box-shadow:0 12rpx 32rpx rgba(236,72,153,.35)}.banner__title{color:#fff;display:block;font-size:36rpx;font-weight:700}.banner__desc{color:hsla(0,0%,100%,.85);display:block;font-size:26rpx;margin-top:8rpx}.card{background:#fff;border-radius:40rpx;box-shadow:0 8rpx 32rpx rgba(30,41,59,.06);margin-top:28rpx;padding:36rpx}.card__label{color:#1e293b;display:block;font-size:28rpx;font-weight:600;margin-bottom:20rpx}.card__label-row{align-items:center;display:flex;justify-content:space-between;margin-bottom:20rpx}.card__label-row .card__label{margin-bottom:0}.card__value{color:#6366f1;font-size:28rpx;font-weight:700}.card__action{background:#eef2ff;border-radius:999rpx;color:#6366f1;font-size:24rpx;padding:8rpx 20rpx}.card__tip{color:#94a3b8;display:block;font-size:24rpx;margin-top:16rpx}.pick{align-items:center;display:flex;flex-direction:column}.pick--empty{border:2rpx dashed #cbd5e1;border-radius:32rpx;height:280rpx;justify-content:center}.pick__plus{color:#94a3b8;font-size:64rpx}.pick__hint{color:#94a3b8;font-size:26rpx;margin-top:12rpx}.brush__stage{background:#f1f5f9;border-radius:28rpx;height:0;overflow:hidden;position:relative;width:100%}.brush__img{height:100%;left:0;position:absolute;top:0;width:100%}.brush__mask{height:100%;left:0;position:absolute;top:0;width:100%}.row{display:flex;gap:20rpx}.tool-btn{align-items:center;background:#f1f5f9;border-radius:999rpx;color:#475569;display:flex;flex:1;font-size:28rpx;height:72rpx;justify-content:center}.result-img{background:#f1f5f9;border-radius:28rpx;height:480rpx;width:100%}.result__save{align-items:center;background:#eef2ff;border-radius:999rpx;color:#4f46e5;display:flex;font-size:28rpx;font-weight:600;height:80rpx;justify-content:center;margin-top:24rpx}.footer{background:rgba(245,246,250,.96);bottom:0;left:0;padding:20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));position:fixed;right:0}.footer__btn{align-items:center;border-radius:32rpx;color:#fff;display:flex;font-size:32rpx;font-weight:700;height:96rpx;justify-content:center}.footer__btn.banner--amber{box-shadow:0 12rpx 32rpx rgba(245,158,11,.4)}.footer__btn.banner--pink{box-shadow:0 12rpx 32rpx rgba(236,72,153,.4)}.footer__btn--disabled{opacity:.6}.footer-placeholder{height:180rpx}
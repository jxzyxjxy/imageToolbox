.page{min-height:100vh;padding-bottom:40rpx}.hero{align-items:center;background:linear-gradient(135deg,#6366f1,#8b5cf6,#a855f7);border-radius:0 0 56rpx 56rpx;display:flex;flex-direction:column;overflow:hidden;padding:120rpx 32rpx 64rpx;position:relative}.hero__glow{background:hsla(0,0%,100%,.12);border-radius:50%;position:absolute}.hero__glow--tr{height:320rpx;right:-80rpx;top:-120rpx;width:320rpx}.hero__glow--bl{background:hsla(0,0%,100%,.08);bottom:-100rpx;height:240rpx;left:-60rpx;width:240rpx}.hero__logo{align-items:center;background:hsla(0,0%,100%,.22);border-radius:40rpx;box-shadow:0 12rpx 32rpx rgba(99,102,241,.45);display:flex;height:128rpx;justify-content:center;width:128rpx}.hero__logo-icon{font-size:56rpx}.hero__title{color:#fff;font-size:48rpx;font-weight:700;margin-top:28rpx}.hero__subtitle{color:hsla(0,0%,100%,.85);font-size:26rpx;margin-top:12rpx}.section{padding:32rpx 32rpx 0}.section__title{color:#64748b;display:block;font-size:26rpx;font-weight:600;margin-bottom:24rpx}.grid{display:flex;flex-wrap:wrap;gap:28rpx}.card{background:#fff;border-radius:40rpx;box-shadow:0 8rpx 32rpx rgba(30,41,59,.06);padding:40rpx 32rpx;position:relative;width:calc(50% - 14rpx)}.card--disabled{opacity:.6}.card__tag-wrap{position:absolute;right:20rpx;top:20rpx}.card__tag{border-radius:999rpx;font-size:20rpx;padding:6rpx 16rpx}.card__tag--ready{background:linear-gradient(135deg,#6366f1,#a855f7);color:#fff}.card__tag--soon{background:#f1f5f9;color:#94a3b8}.card__icon{align-items:center;border-radius:32rpx;box-shadow:0 8rpx 20rpx rgba(30,41,59,.12);display:flex;height:112rpx;justify-content:center;width:112rpx}.card__icon-glyph{font-size:48rpx}.card__name{color:#1e293b;display:block;font-size:30rpx;font-weight:700;margin-top:24rpx}.card__desc{color:#64748b;display:block;display:-webkit-box;font-size:24rpx;-webkit-line-clamp:2;margin-top:8rpx;overflow:hidden;text-overflow:ellipsis;-webkit-box-orient:vertical}
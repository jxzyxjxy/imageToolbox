.uprof__entry{align-items:center;backdrop-filter:blur(8rpx);background:hsla(0,0%,100%,.22);border:1rpx solid hsla(0,0%,100%,.35);border-radius:999rpx;display:flex;flex-direction:row;gap:10rpx;padding:8rpx 20rpx 8rpx 8rpx;position:absolute;right:20rpx;top:120rpx;z-index:5}.uprof__entry:active{opacity:.75}.uprof__avatar{background:hsla(0,0%,100%,.3);border-radius:50%;height:48rpx;width:48rpx}.uprof__avatar--empty{align-items:center;display:flex;justify-content:center}.uprof__avatar-glyph{font-size:28rpx;opacity:.95}.uprof__name{color:#fff;font-size:24rpx;max-width:180rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.uprof__mask{align-items:flex-end;background:rgba(15,23,42,.45);display:flex;inset:0;justify-content:center;position:fixed;z-index:100}.uprof__panel{align-items:center;animation:uprof-rise .25s ease;background:#fff;border-radius:32rpx 32rpx 0 0;display:flex;flex-direction:column;max-width:480rpx;padding:44rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));position:relative;width:100%}@keyframes uprof-rise{from{opacity:0;transform:translateY(60rpx)}to{opacity:1;transform:translateY(0)}}.uprof__panel-title{color:#1e293b;font-size:32rpx;font-weight:700}.uprof__panel-desc{color:#64748b;font-size:24rpx;margin-top:12rpx;text-align:center}.uprof__avatar-btn{background:transparent;border-radius:50%;height:144rpx;line-height:normal;margin-top:36rpx;padding:0;width:144rpx}.uprof__avatar-btn::after{border:none}.uprof__close{align-items:center;background:#f1f5f9;border-radius:50%;display:flex;height:56rpx;justify-content:center;position:absolute;right:24rpx;top:24rpx;width:56rpx}.uprof__close:active{opacity:.7}.uprof__close-icon{color:#64748b;font-size:40rpx;line-height:1}.uprof__save--guide{margin-top:40rpx}.uprof__skip{margin-top:24rpx;padding:12rpx 32rpx}.uprof__skip:active{opacity:.6}.uprof__skip-text{color:#94a3b8;font-size:26rpx}.uprof__avatar-preview{background:#f2f5ff;border:2rpx dashed #c7d2fe;border-radius:50%;height:144rpx;width:144rpx}.uprof__avatar-preview--empty{align-items:center;display:flex;justify-content:center}.uprof__avatar-plus{color:#6366f1;font-size:56rpx;font-weight:300}.uprof__avatar-hint{color:#94a3b8;font-size:22rpx;margin-top:14rpx}.uprof__nickname{background:#f5f6fa;border-radius:16rpx;box-sizing:border-box;color:#1e293b;font-size:28rpx;height:88rpx;margin-top:32rpx;padding:0 28rpx;width:100%}.uprof__save{background:linear-gradient(135deg,#6366f1,#8b5cf6,#a855f7);border-radius:24rpx;box-shadow:0 8rpx 20rpx rgba(139,92,246,.35);color:#fff;font-size:30rpx;font-weight:600;height:96rpx;line-height:96rpx;margin-top:36rpx;width:100%}.uprof__save::after{border:none}.uprof__save[disabled]{opacity:.6}.page{min-height:100vh;padding-bottom:40rpx}.hero{align-items:center;background:linear-gradient(135deg,#6366f1,#8b5cf6,#a855f7);border-radius:0 0 56rpx 56rpx;display:flex;flex-direction:column;overflow:hidden;padding:120rpx 32rpx 64rpx;position:relative}.hero__glow{background:hsla(0,0%,100%,.12);border-radius:50%;position:absolute}.hero__glow--tr{height:320rpx;right:-80rpx;top:-120rpx;width:320rpx}.hero__glow--bl{background:hsla(0,0%,100%,.08);bottom:-100rpx;height:240rpx;left:-60rpx;width:240rpx}.hero__logo{align-items:center;background:hsla(0,0%,100%,.22);border-radius:40rpx;box-shadow:0 12rpx 32rpx rgba(99,102,241,.45);display:flex;height:128rpx;justify-content:center;width:128rpx}.hero__logo-icon{font-size:56rpx}.hero__title{color:#fff;font-size:48rpx;font-weight:700;margin-top:28rpx}.hero__subtitle{color:hsla(0,0%,100%,.85);font-size:26rpx;margin-top:12rpx}.section{padding:32rpx 32rpx 0}.section__title{color:#64748b;display:block;font-size:26rpx;font-weight:600;margin-bottom:24rpx}.grid{display:flex;flex-wrap:wrap;gap:28rpx}.card{background:#fff;border-radius:40rpx;box-shadow:0 8rpx 32rpx rgba(30,41,59,.06);padding:40rpx 32rpx;position:relative;width:calc(50% - 14rpx)}.card--disabled{opacity:.6}.card__tag-wrap{position:absolute;right:20rpx;top:20rpx}.card__tag{border-radius:999rpx;font-size:20rpx;padding:6rpx 16rpx}.card__tag--ready{background:linear-gradient(135deg,#6366f1,#a855f7);color:#fff}.card__tag--soon{background:#f1f5f9;color:#94a3b8}.card__icon{align-items:center;border-radius:32rpx;box-shadow:0 8rpx 20rpx rgba(30,41,59,.12);display:flex;height:112rpx;justify-content:center;width:112rpx}.card__icon-glyph{font-size:48rpx}.card__name{color:#1e293b;display:block;font-size:30rpx;font-weight:700;margin-top:24rpx}.card__desc{color:#64748b;display:block;display:-webkit-box;font-size:24rpx;-webkit-line-clamp:2;margin-top:8rpx;overflow:hidden;text-overflow:ellipsis;-webkit-box-orient:vertical}
.page{min-height:100vh;padding:32rpx 32rpx 200rpx}.banner{background:linear-gradient(135deg,#10b981,#059669);border-radius:40rpx;box-shadow:0 12rpx 32rpx rgba(16,185,129,.35);padding:40rpx 36rpx}.banner__title{color:#fff;display:block;font-size:36rpx;font-weight:700}.banner__desc{color:hsla(0,0%,100%,.85);display:block;font-size:26rpx;margin-top:8rpx}.card{background:#fff;border-radius:40rpx;box-shadow:0 8rpx 32rpx rgba(30,41,59,.06);margin-top:28rpx;padding:36rpx}.card__label{color:#1e293b;display:block;font-size:28rpx;font-weight:600;margin-bottom:20rpx}.card__actions{display:flex;gap:20rpx;margin-top:28rpx}.picker{align-items:center;background:#f8fafc;border:2rpx dashed #cbd5e1;border-radius:28rpx;display:flex;flex-direction:column;justify-content:center;padding:72rpx 0}.picker__icon{font-size:64rpx}.picker__text{color:#94a3b8;font-size:26rpx;margin-top:16rpx}.preview{background:#0f172a;border-radius:28rpx;overflow:hidden;position:relative}.preview__thumb{display:block;height:360rpx;width:100%}.preview__info{align-items:center;background:linear-gradient(180deg,transparent,rgba(15,23,42,.8));bottom:0;display:flex;gap:24rpx;left:0;padding:40rpx 24rpx 16rpx;position:absolute;right:0}.preview__size{color:#fff;font-size:26rpx;font-weight:700}.preview__duration{color:hsla(0,0%,100%,.75);font-size:24rpx}.preview__rechoose{background:rgba(15,23,42,.55);border-radius:999rpx;color:#fff;font-size:22rpx;padding:8rpx 20rpx;position:absolute;right:16rpx;top:16rpx}.levels{display:flex;gap:16rpx}.level{align-items:center;background:#f8fafc;border:3rpx solid #e2e8f0;border-radius:24rpx;display:flex;flex:1;flex-direction:column;padding:24rpx 12rpx;transition:border-color .15s,background .15s}.level--active{background:#ecfdf5;border-color:#10b981}.level__name{color:#1e293b;font-size:28rpx;font-weight:700}.level__desc{color:#64748b;font-size:20rpx;margin-top:8rpx;text-align:center}.result{background:#f8fafc;border-radius:24rpx;padding:24rpx 28rpx}.result__row{align-items:center;display:flex;justify-content:space-between;padding:10rpx 0}.result__k{color:#64748b;font-size:26rpx}.result__v{color:#1e293b;font-size:28rpx;font-weight:700}.result__v--hl{color:#10b981}.btn{align-items:center;border-radius:24rpx;display:flex;flex:1;height:88rpx;justify-content:center}.btn--ghost{background:#f1f5f9}.btn--primary{background:linear-gradient(135deg,#10b981,#059669);box-shadow:0 8rpx 24rpx rgba(16,185,129,.35)}.btn__text{color:#fff;font-size:28rpx;font-weight:600}.btn__text--ghost{color:#475569}.footer{background:linear-gradient(180deg,rgba(245,246,250,0),rgba(245,246,250,.96) 40%);bottom:0;display:flex;justify-content:center;left:0;padding:20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));position:fixed;right:0}.footer__btn{align-items:center;background:linear-gradient(135deg,#10b981,#059669);border-radius:24rpx;box-shadow:0 10rpx 28rpx rgba(16,185,129,.35);display:flex;height:96rpx;justify-content:center;max-width:686rpx;width:100%}.footer__btn--disabled{opacity:.55}.footer__btn-text{color:#fff;font-size:30rpx;font-weight:700}
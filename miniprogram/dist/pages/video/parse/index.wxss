.page{min-height:100vh;padding:32rpx 32rpx 260rpx}.banner{background:linear-gradient(135deg,#f59e0b,#f97316);border-radius:40rpx;box-shadow:0 12rpx 32rpx rgba(249,115,22,.35);padding:40rpx 36rpx}.banner__title{color:#fff;display:block;font-size:36rpx;font-weight:700}.banner__desc{color:hsla(0,0%,100%,.85);display:block;font-size:26rpx;margin-top:8rpx}.card{background:#fff;border-radius:40rpx;box-shadow:0 8rpx 32rpx rgba(30,41,59,.06);margin-top:28rpx;padding:36rpx}.card__label{color:#1e293b;display:block;font-size:28rpx;font-weight:600}.card__label-row{align-items:center;display:flex;justify-content:space-between;margin-bottom:20rpx}.card__label-row .card__label{margin-bottom:0}.card__paste{background:#fff7ed;border:2rpx solid #fed7aa;border-radius:999rpx;color:#f97316;font-size:26rpx;font-weight:600;padding:6rpx 24rpx}.card__tip{color:#94a3b8;display:block;font-size:22rpx;margin-top:16rpx}.input{background:#f8fafc;border:2rpx solid #e2e8f0;border-radius:24rpx;box-sizing:border-box;color:#1e293b;font-size:28rpx;min-height:160rpx;padding:24rpx;width:100%}.result{background:#f8fafc;border-radius:24rpx;display:flex;gap:24rpx;padding:24rpx}.result__cover{background:#e2e8f0;border-radius:16rpx;flex-shrink:0;height:260rpx;width:200rpx}.result__cover--empty{align-items:center;display:flex;justify-content:center}.result__cover-icon{font-size:56rpx}.result__meta{display:flex;flex:1;flex-direction:column;gap:12rpx;justify-content:center;min-width:0}.result__title{color:#1e293b;display:-webkit-box;font-size:28rpx;font-weight:600;-webkit-line-clamp:2;overflow:hidden;text-overflow:ellipsis;-webkit-box-orient:vertical}.result__size{color:#f97316;font-size:24rpx;font-weight:600}.result__note{color:#94a3b8;font-size:22rpx}.btn{align-items:center;background:linear-gradient(135deg,#f59e0b,#f97316);border-radius:24rpx;box-shadow:0 8rpx 24rpx rgba(249,115,22,.35);display:flex;height:88rpx;justify-content:center;margin-top:28rpx}.btn--disabled{opacity:.55}.btn__text{color:#fff;font-size:28rpx;font-weight:600}.footer{align-items:center;background:linear-gradient(180deg,rgba(245,246,250,0),rgba(245,246,250,.96) 40%);bottom:0;display:flex;flex-direction:column;gap:16rpx;left:0;padding:20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));position:fixed;right:0}.footer__btn{align-items:center;background:linear-gradient(135deg,#f59e0b,#f97316);border-radius:24rpx;box-shadow:0 10rpx 28rpx rgba(249,115,22,.35);display:flex;height:96rpx;justify-content:center;max-width:686rpx;width:100%}.footer__btn--disabled{opacity:.55}.footer__btn-text{color:#fff;font-size:30rpx;font-weight:700}.footer__legal{color:#94a3b8;font-size:20rpx}
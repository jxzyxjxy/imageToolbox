.page{min-height:100vh;padding:32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom))}.banner{background:linear-gradient(135deg,#f59e0b,#f97316);border-radius:40rpx;box-shadow:0 12rpx 32rpx rgba(249,115,22,.35);padding:40rpx 36rpx}.banner__title{color:#fff;display:block;font-size:36rpx;font-weight:700}.banner__desc{color:hsla(0,0%,100%,.85);display:block;font-size:26rpx;margin-top:8rpx}.card{background:#fff;border-radius:40rpx;box-shadow:0 8rpx 32rpx rgba(30,41,59,.06);margin-top:28rpx;padding:36rpx}.input{background:#f8fafc;border:2rpx solid #e2e8f0;border-radius:24rpx;box-sizing:border-box;color:#1e293b;font-size:28rpx;min-height:160rpx;padding:24rpx;width:100%}.actions{display:flex;gap:20rpx;margin-top:24rpx}.actions__paste{align-items:center;background:#fff;border:2rpx solid #fdba74;border-radius:24rpx;display:flex;flex:1;height:88rpx;justify-content:center}.actions__paste-text{color:#f97316;font-size:28rpx;font-weight:600}.actions__parse{align-items:center;background:linear-gradient(135deg,#f59e0b,#f97316);border-radius:24rpx;box-shadow:0 8rpx 24rpx rgba(249,115,22,.35);display:flex;flex:1.4;height:88rpx;justify-content:center}.actions__parse.is-disabled{opacity:.55}.actions__parse-text{color:#fff;font-size:28rpx;font-weight:700}.legal{align-items:center;display:flex;flex-wrap:wrap;justify-content:center;margin-top:20rpx}.legal__text{color:#94a3b8;font-size:22rpx}.legal__link{color:#f97316;font-size:22rpx}
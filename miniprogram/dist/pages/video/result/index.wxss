.page{min-height:100vh;padding:24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom))}.tabs{background:#fff;border-radius:24rpx;box-shadow:0 8rpx 32rpx rgba(30,41,59,.06);display:flex;padding:8rpx}.tabs__item{align-items:center;border-radius:18rpx;display:flex;flex:1;height:72rpx;justify-content:center}.tabs__text{color:#94a3b8;font-size:28rpx;font-weight:600}.tabs__text.is-active{color:#f97316}.tabs__item.is-active{background:#fff7ed}.card{background:#fff;border-radius:40rpx;box-shadow:0 8rpx 32rpx rgba(30,41,59,.06);margin-top:24rpx;padding:32rpx}.player{background:#0f172a;border-radius:24rpx;height:420rpx;overflow:hidden;width:100%}.player--fallback{align-items:center;display:flex;flex-direction:column;gap:16rpx;justify-content:center}.player__poster{height:420rpx;position:absolute;width:100%}.player__err{background:rgba(15,23,42,.55);border-radius:999rpx;color:hsla(0,0%,100%,.9);font-size:24rpx;padding:8rpx 24rpx;position:relative}.meta{display:flex;flex-direction:column;gap:10rpx;margin-top:24rpx}.meta__item{color:#475569;font-size:26rpx}.btn-row{display:flex;gap:20rpx;margin-top:28rpx}.btn-row__sub{align-items:center;background:#fff;border:2rpx solid #fdba74;border-radius:24rpx;display:flex;flex:1;height:88rpx;justify-content:center}.btn-row__sub-text{color:#f97316;font-size:28rpx;font-weight:600}.btn-row__main{align-items:center;background:linear-gradient(135deg,#f59e0b,#f97316);border-radius:24rpx;box-shadow:0 8rpx 24rpx rgba(249,115,22,.35);display:flex;flex:1.4;height:88rpx;justify-content:center}.btn-row__main.is-disabled{opacity:.55}.btn-row__main-text{color:#fff;font-size:28rpx;font-weight:700}.btn-main{align-items:center;background:linear-gradient(135deg,#f59e0b,#f97316);border-radius:24rpx;box-shadow:0 8rpx 24rpx rgba(249,115,22,.35);display:flex;height:88rpx;justify-content:center;margin-top:28rpx}.btn-main.is-disabled{opacity:.55}.btn-main__text{color:#fff;font-size:28rpx;font-weight:700}.cover{background:#f1f5f9;border-radius:24rpx;min-height:320rpx;width:100%}.cover--empty{align-items:center;display:flex;height:320rpx;justify-content:center}.cover__empty-text{color:#94a3b8;font-size:26rpx}.title-text{color:#1e293b;display:block;font-size:28rpx;font-weight:600;line-height:1.6;word-break:break-all}.title-note{color:#94a3b8;display:block;font-size:22rpx;margin-top:12rpx}.empty{align-items:center;display:flex;flex-direction:column;gap:24rpx;padding:80rpx 32rpx}.empty__icon{font-size:72rpx}.empty__text{color:#64748b;font-size:26rpx}
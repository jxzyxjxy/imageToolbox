.page{min-height:100vh;padding:32rpx 32rpx 0}.banner{background:linear-gradient(135deg,#f59e0b,#f97316);border-radius:40rpx;box-shadow:0 12rpx 32rpx rgba(245,158,11,.35);padding:40rpx 36rpx}.banner__title{color:#fff;display:block;font-size:36rpx;font-weight:700}.banner__desc{color:hsla(0,0%,100%,.85);display:block;font-size:26rpx;margin-top:8rpx}.card{background:#fff;border-radius:40rpx;box-shadow:0 8rpx 32rpx rgba(30,41,59,.06);margin-top:28rpx;padding:36rpx}.card__label{color:#1e293b;display:block;font-size:28rpx;font-weight:600;margin-bottom:20rpx}.pick{align-items:center;display:flex;flex-direction:column}.pick--empty{border:2rpx dashed #cbd5e1;border-radius:32rpx;height:280rpx;justify-content:center}.pick__plus{color:#94a3b8;font-size:64rpx}.pick__hint{color:#94a3b8;font-size:26rpx;margin-top:12rpx}.pick__img{background:#f1f5f9;border-radius:32rpx;height:360rpx;width:100%}.pick__size{color:#64748b;font-size:24rpx;margin-top:16rpx}.compare{display:flex;gap:20rpx}.compare__item{align-items:center;display:flex;flex:1;flex-direction:column}.compare__img{background:#f1f5f9;border-radius:28rpx;height:320rpx;width:100%}.compare__cap{color:#64748b;font-size:24rpx;margin-top:12rpx}.compare__cap--ok{color:#f59e0b;font-weight:600}.result__save{align-items:center;background:#fffbeb;border-radius:999rpx;color:#d97706;display:flex;font-size:28rpx;font-weight:600;height:80rpx;justify-content:center;margin-top:28rpx}.footer{background:rgba(245,246,250,.96);bottom:0;left:0;padding:20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));position:fixed;right:0}.footer__btn{align-items:center;background:linear-gradient(135deg,#f59e0b,#f97316);border-radius:32rpx;box-shadow:0 12rpx 32rpx rgba(245,158,11,.4);color:#fff;display:flex;font-size:32rpx;font-weight:700;height:96rpx;justify-content:center}.footer__btn--disabled{opacity:.6}.footer-placeholder{height:180rpx}
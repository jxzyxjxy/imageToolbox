.page{min-height:100vh;padding:32rpx 32rpx 0}.banner{background:linear-gradient(135deg,#0ea5e9,#2563eb);border-radius:40rpx;box-shadow:0 12rpx 32rpx rgba(14,165,233,.35);padding:40rpx 36rpx}.banner__title{color:#fff;display:block;font-size:36rpx;font-weight:700}.banner__desc{color:hsla(0,0%,100%,.85);display:block;font-size:26rpx;margin-top:8rpx}.card{background:#fff;border-radius:40rpx;box-shadow:0 8rpx 32rpx rgba(30,41,59,.06);margin-top:28rpx;padding:36rpx}.card__label{color:#1e293b;display:block;font-size:28rpx;font-weight:600;margin-bottom:20rpx}.card__label-row{align-items:center;display:flex;justify-content:space-between;margin-bottom:20rpx}.card__label-row .card__label{margin-bottom:0}.card__value{color:#0ea5e9;font-size:28rpx;font-weight:700}.card__action{background:#eef2ff;border-radius:999rpx;color:#6366f1;font-size:24rpx;padding:8rpx 20rpx}.card__tip{color:#94a3b8;display:block;font-size:24rpx;margin-top:16rpx}.pick{align-items:center;display:flex;flex-direction:column}.pick--empty{border:2rpx dashed #cbd5e1;border-radius:32rpx;height:280rpx;justify-content:center}.pick__plus{color:#94a3b8;font-size:64rpx}.pick__hint{color:#94a3b8;font-size:26rpx;margin-top:12rpx}.pick__img{background:#f1f5f9;border-radius:32rpx;height:360rpx;width:100%}.colors{display:flex;flex-wrap:wrap;gap:20rpx}.colors__item{align-items:center;border:2rpx solid #e2e8f0;border-radius:24rpx;display:flex;flex-direction:column;padding:16rpx 20rpx}.colors__item--active{background:#f0f9ff;border-color:#38bdf8}.colors__dot{border:2rpx solid #e2e8f0;border-radius:50%;height:56rpx;width:56rpx}.colors__name{color:#475569;font-size:22rpx;margin-top:8rpx}.specs{display:flex;flex-wrap:wrap;gap:20rpx}.specs__item{align-items:center;border:2rpx solid #e2e8f0;border-radius:24rpx;display:flex;flex-direction:column;padding:24rpx 8rpx;width:calc(33.33% - 14rpx)}.specs__item--active{background:#f0f9ff;border-color:#38bdf8}.specs__name{color:#1e293b;font-size:28rpx;font-weight:600}.specs__mm{color:#94a3b8;font-size:20rpx;margin-top:4rpx}.photo-wrap{background:#f1f5f9;border-radius:28rpx;display:flex;justify-content:center;padding:24rpx;position:relative}.photo{border-radius:12rpx;box-shadow:0 8rpx 24rpx rgba(30,41,59,.18);height:448rpx;width:320rpx}.photo--placeholder{align-items:center;background:linear-gradient(135deg,#eef4ff,#f6f9ff);border:2rpx dashed #bcd3f5;box-shadow:none;box-sizing:border-box;display:flex;flex-direction:column;justify-content:center;padding:24rpx}.placeholder__title{color:#1e4e8c;font-size:26rpx;font-weight:600;margin-top:24rpx}.placeholder__desc{color:#64748b;font-size:22rpx;margin-top:10rpx}.spinner{animation:idp-spin .8s linear infinite;border:5rpx solid rgba(14,165,233,.18);border-radius:50%;border-top-color:#0ea5e9;height:36rpx;width:36rpx}.spinner--lg{border-width:7rpx;height:56rpx;width:56rpx}.photo-mask{align-items:center;background:hsla(0,0%,100%,.72);border-radius:12rpx;display:flex;flex-direction:column;inset:24rpx;justify-content:center;position:absolute}.photo-mask__text{color:#1e4e8c;font-size:24rpx;font-weight:600;margin-top:16rpx}@keyframes idp-spin{to{transform:rotate(1turn)}}.result__save{align-items:center;background:#f0f9ff;border-radius:999rpx;color:#0284c7;display:flex;font-size:28rpx;font-weight:600;height:80rpx;justify-content:center;margin-top:24rpx}.footer{background:rgba(245,246,250,.96);bottom:0;left:0;padding:20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));position:fixed;right:0}.footer__btn{align-items:center;background:linear-gradient(135deg,#0ea5e9,#2563eb);border-radius:32rpx;box-shadow:0 12rpx 32rpx rgba(14,165,233,.4);color:#fff;display:flex;font-size:32rpx;font-weight:700;height:96rpx;justify-content:center}.footer__btn--disabled{opacity:.6}.footer-placeholder{height:180rpx}
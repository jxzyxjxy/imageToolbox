.page{min-height:100vh;padding:32rpx 32rpx 0}.banner{background:linear-gradient(135deg,#10b981,#059669);border-radius:40rpx;box-shadow:0 12rpx 32rpx rgba(16,185,129,.35);padding:40rpx 36rpx}.banner__title{color:#fff;display:block;font-size:36rpx;font-weight:700}.banner__desc{color:hsla(0,0%,100%,.85);display:block;font-size:26rpx;margin-top:8rpx}.card{background:#fff;border-radius:40rpx;box-shadow:0 8rpx 32rpx rgba(30,41,59,.06);margin-top:28rpx;padding:36rpx}.card__label{color:#1e293b;display:block;font-size:28rpx;font-weight:600;margin-bottom:20rpx}.card__label-row{align-items:center;display:flex;justify-content:space-between;margin-bottom:20rpx}.card__label-row .card__label{margin-bottom:0}.card__value{color:#10b981;font-size:28rpx;font-weight:700}.card__tip{color:#94a3b8;display:block;font-size:24rpx;margin-top:16rpx}.pick{align-items:center;display:flex;flex-direction:column}.pick--empty{border:2rpx dashed #cbd5e1;border-radius:32rpx;height:280rpx;justify-content:center}.pick__plus{color:#94a3b8;font-size:64rpx}.pick__hint{color:#94a3b8;font-size:26rpx;margin-top:12rpx}.pick__img{background:#f1f5f9;border-radius:32rpx;height:360rpx;width:100%}.pick__size{color:#64748b;font-size:24rpx;margin-top:16rpx}.result__img{background:#f1f5f9;border-radius:32rpx;height:360rpx;width:100%}.result__stats{align-items:center;display:flex;gap:32rpx;justify-content:center;margin-top:24rpx}.result__stat{align-items:center;display:flex;flex-direction:column}.result__num{color:#1e293b;font-size:34rpx;font-weight:700}.result__num--ok{color:#10b981}.result__cap{color:#94a3b8;font-size:22rpx;margin-top:4rpx}.result__arrow{color:#cbd5e1;font-size:40rpx}.result__save{align-items:center;background:#ecfdf5;border-radius:999rpx;color:#059669;display:flex;font-size:28rpx;font-weight:600;height:80rpx;justify-content:center;margin-top:28rpx}.footer{background:rgba(245,246,250,.96);bottom:0;left:0;padding:20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));position:fixed;right:0}.footer__btn{align-items:center;background:linear-gradient(135deg,#10b981,#059669);border-radius:32rpx;box-shadow:0 12rpx 32rpx rgba(16,185,129,.4);color:#fff;display:flex;font-size:32rpx;font-weight:700;height:96rpx;justify-content:center}.footer__btn--disabled{opacity:.6}.footer-placeholder{height:180rpx}
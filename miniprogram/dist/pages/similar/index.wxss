.page{min-height:100vh;padding:32rpx 32rpx 0}.banner{background:linear-gradient(135deg,#6366f1,#a855f7);border-radius:40rpx;box-shadow:0 12rpx 32rpx rgba(99,102,241,.35);padding:40rpx 36rpx}.banner__title{color:#fff;display:block;font-size:36rpx;font-weight:700}.banner__desc{color:hsla(0,0%,100%,.85);display:block;font-size:26rpx;margin-top:8rpx}.card{background:#fff;border-radius:40rpx;box-shadow:0 8rpx 32rpx rgba(30,41,59,.06);margin-top:28rpx;padding:36rpx}.card__label{color:#1e293b;display:block;font-size:28rpx;font-weight:600;margin-bottom:20rpx}.card__label-row{align-items:center;display:flex;justify-content:space-between;margin-bottom:20rpx}.card__label-row .card__label{margin-bottom:0}.card__value{color:#6366f1;font-size:28rpx;font-weight:700}.card__action{background:#eef2ff;border-radius:999rpx;color:#6366f1;font-size:24rpx;padding:8rpx 20rpx}.card__tip{color:#94a3b8;display:block;font-size:24rpx;margin-top:16rpx}.pick{align-items:center;display:flex;flex-direction:column}.pick--empty{border:2rpx dashed #cbd5e1;border-radius:32rpx;height:280rpx;justify-content:center}.pick__plus{color:#94a3b8;font-size:64rpx}.pick__hint{color:#94a3b8;font-size:26rpx;margin-top:12rpx}.pick__img{background:#f1f5f9;border-radius:32rpx;height:360rpx;width:100%}.pick__meta{align-items:center;display:flex;flex-direction:column;margin-top:16rpx}.pick__size{color:#64748b;font-size:24rpx}.pick__re{color:#94a3b8;font-size:22rpx;margin-top:4rpx}.row{display:flex;gap:20rpx}.opt{align-items:center;border:2rpx solid #e2e8f0;border-radius:28rpx;display:flex;flex:1;flex-direction:column;padding:24rpx;position:relative}.opt--active{background:#eef2ff;border-color:#818cf8}.opt--locked{opacity:.55}.opt__lock{background:#f1f5f9;border-radius:999rpx;color:#94a3b8;font-size:18rpx;padding:2rpx 12rpx;position:absolute;right:10rpx;top:10rpx}.opt__name{color:#1e293b;font-size:28rpx;font-weight:600}.opt__desc{color:#64748b;font-size:22rpx;margin-top:6rpx}.size-row{align-items:center;display:flex;gap:20rpx}.size-input{background:#f8fafc;border:2rpx solid #e2e8f0;border-radius:24rpx;color:#1e293b;flex:1;font-size:30rpx;height:88rpx;padding:0 28rpx}.size-x{color:#94a3b8;font-size:32rpx}.chip{align-items:center;border:2rpx solid #e2e8f0;border-radius:999rpx;color:#475569;display:flex;flex:1;font-size:28rpx;height:72rpx;justify-content:center}.chip--active{background:#eef2ff;border-color:#818cf8;color:#4f46e5;font-weight:600}.results{display:flex;flex-wrap:wrap;margin:0 -10rpx}.results__item{box-sizing:border-box;display:flex;flex-direction:column;padding:0 10rpx 20rpx;width:50%}.results--single .results__item{width:100%}.results__img{background:#f1f5f9;border-radius:28rpx;height:320rpx;width:100%}.results--single .results__img{height:520rpx}.results__save{align-items:center;background:#eef2ff;border-radius:999rpx;color:#4f46e5;display:flex;font-size:26rpx;height:64rpx;justify-content:center;margin-top:14rpx}.footer{background:rgba(245,246,250,.96);bottom:0;left:0;padding:20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));position:fixed;right:0}.footer__btn{align-items:center;background:linear-gradient(135deg,#6366f1,#a855f7);border-radius:32rpx;box-shadow:0 12rpx 32rpx rgba(99,102,241,.4);color:#fff;display:flex;font-size:32rpx;font-weight:700;height:96rpx;justify-content:center}.footer__btn--disabled{opacity:.6}.footer-placeholder{height:180rpx}
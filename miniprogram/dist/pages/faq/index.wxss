.faq{background:#f5f6fa;box-sizing:border-box;min-height:100vh;padding:24rpx 32rpx 60rpx}.faq__card{background:#fff;border-radius:32rpx;box-shadow:0 8rpx 32rpx rgba(30,41,59,.06);padding:8rpx 32rpx}.faq__item{border-bottom:1rpx solid #f1f5f9}.faq__item--last{border-bottom:none}.faq__q{align-items:center;display:flex;justify-content:space-between;padding:30rpx 0}.faq__q-text{color:#1e293b;flex:1;font-size:30rpx;font-weight:600;margin-right:16rpx}.faq__q-arrow{color:#94a3b8;flex-shrink:0;font-size:32rpx;line-height:1;transform:rotate(0deg);transition:transform .25s ease}.faq__q-arrow--open{transform:rotate(180deg)}.faq__a{padding:0 0 30rpx}.faq__a-text{color:#64748b;display:block;font-size:26rpx;line-height:1.7}.faq__tip{color:#94a3b8;display:block;font-size:24rpx;margin-top:32rpx;text-align:center}
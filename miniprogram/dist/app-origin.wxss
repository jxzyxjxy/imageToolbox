page{background-color:#f5f6fa;color:#1e293b;font-size:28rpx;line-height:1.5}button,image,input,text,view{box-sizing:border-box}button{background:none;border:none;font-size:inherit;line-height:inherit;margin:0;padding:0}button::after{border:none}.ai-mark{align-items:center;background:#fef3c7;border:1rpx solid #fcd34d;border-radius:999rpx;color:#b45309;display:inline-flex;font-size:22rpx;font-weight:500;line-height:1.6;margin-top:12rpx;padding:4rpx 16rpx}.banner__ai{align-items:center;display:flex;margin-top:18rpx}.banner__ai-badge{background:hsla(0,0%,100%,.94);border-radius:999rpx;color:#7c3aed;flex-shrink:0;font-size:20rpx;font-weight:600;line-height:1.7;margin-right:12rpx;padding:3rpx 14rpx}.banner__ai-text{color:hsla(0,0%,100%,.88);font-size:22rpx}